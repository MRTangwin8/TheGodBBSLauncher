{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "神权论坛启动器",
  "version": "0.1.0",
  "identifier": "me.mcbbs.godbbs",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "神权论坛启动器 — MCBBS 纪念版",
        "width": 1180,
        "height": 760,
        "minWidth": 960,
        "minHeight": 620,
        "decorations": false,
        "devtools": false,
        "shadow": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "windows": {
      "wix": { "language": "zh-CN" },
      "nsis": { "languages": ["SimpChinese", "English"] }
    },
    "linux": {
      "deb": { "desktopTemplate": "linux/app.desktop" },
      "rpm": { "desktopTemplate": "linux/app.desktop" }
    }
  }
}
